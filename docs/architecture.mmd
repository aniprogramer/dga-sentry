flowchart TB

  CLIENT["🖥️ React 19 SPA<br/>Investigation Workbench<br/>Bulk Audit · Port 3100"]

  subgraph Ingress["API Gateway — FastAPI · Port 9000"]
    GW["🛡️ Gateway<br/>Rate Limit · CORS<br/>RFC 1035 · IDN Decode"]
    CACHE["💾 LRU Cache<br/>10K entries · thread-safe<br/>Hit: &lt;100 µs"]
  end

  subgraph Pipeline["Feature Extraction & Cascaded ML Engine"]
    FEAT["⚙️ 13 Lexical Features<br/>Entropy · N-gram · Hex ratio<br/>Consonant runs · Wordninja"]
    S1["🎯 Stage 1: XGBoost<br/>Binary Classifier<br/>F1 87.5% · AUC 0.945"]
    SAFE["🟢 SAFE · P &lt; 0.35<br/>Action: ALLOW"]
    S2["🕵️ Stage 2: Random Forest<br/>25-Family Attribution<br/>Emotet · Conficker · Gozi …"]
  end

  subgraph Output["Enrichment & SOC Verdict"]
    SHAP["🧮 TreeSHAP<br/>Top-3 Risk Factors<br/>C++ booster · &lt;0.2 ms"]
    DNS["🌐 Live DNS (opt-in)<br/>Active C2 vs NXDOMAIN<br/>dnspython · 2s timeout"]
    VERDICT["📋 Enriched Verdict<br/>Safe · Suspicious · Malicious<br/>Family + SHAP + DNS"]
  end

  CLIENT -->|"POST /predict<br/>POST /predict/batch"| GW
  GW --> CACHE
  CACHE -->|"miss"| FEAT
  CACHE -.->|"hit → cached result"| VERDICT
  FEAT -->|"scaled 13-d vector"| S1
  S1 -->|"P &lt; 0.35"| SAFE
  S1 -->|"P ≥ 0.35 · non-safe"| S2
  S2 --> SHAP
  S2 -.->|"resolve_dns=true"| DNS
  SAFE --> VERDICT
  SHAP --> VERDICT
  DNS -.-> VERDICT
  VERDICT -->|"JSON response"| CLIENT

